{
  "name": "verified-financial-core",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@8.15.6",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm build && vitest run",
    "test:live": "pnpm build && vitest run --config vitest.live.config.ts",
    "test:coverage": "pnpm build && vitest run --coverage",
    "test:watch": "pnpm build && vitest",
    "typecheck": "pnpm build && pnpm -r typecheck:local",
    "check": "pnpm build && pnpm -r typecheck:local && vitest run",
    "ah-context": "node apps/ah-gateway-cli/dist/bin.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "fast-check": "^4.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
